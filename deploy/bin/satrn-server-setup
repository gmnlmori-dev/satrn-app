#!/usr/bin/env bash
# Prepara il server per Satrn (una tantum, rieseguibile).
# Non tocca nulla di Stellr: utente, cartelle, servizio, site Nginx e
# porta (3002) sono dedicati.
#
# Uso: sudo bash deploy/bin/satrn-server-setup   (dal checkout del repo)
set -Eeuo pipefail

DEPLOY_USER="satrn"
DEPLOY_HOME="/var/lib/satrn"
BASE_DIR="/opt/satrn"
APP_DIR="${BASE_DIR}/app"
RUNTIME_DIR="${BASE_DIR}/runtime"
REPO_URL="https://github.com/gmnlmori-dev/satrn-app.git"
NODE_VERSION="24.21.0"
NODE_DIST="node-v${NODE_VERSION}-linux-x64"
DOMAIN="satrn.zeroradiation.eu"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"   # cartella deploy/

die() { echo "satrn-server-setup: $*" >&2; exit 1; }
log() { echo "==> $*"; }
as_deploy() { runuser -u "$DEPLOY_USER" -- env HOME="$DEPLOY_HOME" "$@"; }

[[ "$(id -u)" -eq 0 ]] || die "eseguire come root (sudo)"
for c in git curl tar xz nginx systemctl runuser; do
  command -v "$c" >/dev/null 2>&1 || die "comando assente: $c"
done
[[ -f "${here}/systemd/satrn-web.service" ]] || die "eseguire dal checkout del repo (deploy/ non trovata)"

# --- utente di sistema dedicato ----------------------------------------------
if ! getent passwd "$DEPLOY_USER" >/dev/null; then
  log "creo utente di sistema ${DEPLOY_USER}"
  adduser --system --group --home "$DEPLOY_HOME" --shell /usr/sbin/nologin "$DEPLOY_USER"
fi
install -d -o "$DEPLOY_USER" -g "$DEPLOY_USER" -m 0750 "$DEPLOY_HOME"

# --- cartelle -----------------------------------------------------------------
install -d -o root -g "$DEPLOY_USER" -m 0755 "$BASE_DIR"
install -d -o "$DEPLOY_USER" -g "$DEPLOY_USER" -m 0750 "${BASE_DIR}/releases"
install -d -o root -g root -m 0755 "$RUNTIME_DIR"

# --- runtime Node dedicato ----------------------------------------------------
if [[ ! -x "${RUNTIME_DIR}/${NODE_DIST}/bin/node" ]]; then
  log "scarico Node ${NODE_VERSION}"
  tmp="$(mktemp -d)"
  curl -fsSL -o "${tmp}/${NODE_DIST}.tar.xz" "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_DIST}.tar.xz"
  curl -fsSL -o "${tmp}/SHASUMS256.txt" "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"
  (cd "$tmp" && grep " ${NODE_DIST}.tar.xz\$" SHASUMS256.txt | sha256sum -c -)
  tar -xJf "${tmp}/${NODE_DIST}.tar.xz" -C "$RUNTIME_DIR"
  rm -rf -- "$tmp"
fi
ln -sfn "${RUNTIME_DIR}/${NODE_DIST}" "${RUNTIME_DIR}/node"
log "node: $("${RUNTIME_DIR}/node/bin/node" -v)"

# --- repository ---------------------------------------------------------------
install -d -o "$DEPLOY_USER" -g "$DEPLOY_USER" -m 0750 "$APP_DIR"
if [[ ! -d "${APP_DIR}/.git" ]]; then
  log "clono ${REPO_URL} in ${APP_DIR}"
  as_deploy git clone --branch main "$REPO_URL" "$APP_DIR"
fi
as_deploy git -C "$APP_DIR" config user.email "satrn@${DOMAIN}"
as_deploy git -C "$APP_DIR" config user.name "satrn-release"

if [[ ! -f "${APP_DIR}/.env.local" ]]; then
  log "creo modello ${APP_DIR}/.env.local (DA COMPILARE)"
  install -o "$DEPLOY_USER" -g "$DEPLOY_USER" -m 0600 /dev/null "${APP_DIR}/.env.local"
  cat >"${APP_DIR}/.env.local" <<'EOF'
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EOF
fi

# --- script e unit systemd ----------------------------------------------------
log "installo script in /usr/local/sbin"
install -o root -g root -m 0755 "${here}/bin/satrn-release" /usr/local/sbin/satrn-release
install -o root -g root -m 0755 "${here}/bin/satrn-health-heartbeat" /usr/local/sbin/satrn-health-heartbeat

log "installo unit systemd"
install -o root -g root -m 0644 "${here}/systemd/satrn-web.service" /etc/systemd/system/satrn-web.service
install -o root -g root -m 0644 "${here}/systemd/satrn-health-heartbeat.service" /etc/systemd/system/satrn-health-heartbeat.service
install -o root -g root -m 0644 "${here}/systemd/satrn-health-heartbeat.timer" /etc/systemd/system/satrn-health-heartbeat.timer

install -d -o root -g root -m 0755 /etc/satrn
if [[ ! -f /etc/satrn/monitoring.env ]]; then
  log "creo /etc/satrn/monitoring.env (inserire il Ping URL Healthchecks)"
  install -o root -g root -m 0600 /dev/null /etc/satrn/monitoring.env
  echo 'HEALTHCHECKS_PING_URL=""' >/etc/satrn/monitoring.env
fi

systemctl daemon-reload
systemctl enable satrn-web.service >/dev/null
# il servizio parte al primo rilascio (satrn-release), quando esiste /opt/satrn/current

# --- Nginx --------------------------------------------------------------------
log "installo configurazione Nginx"
install -o root -g root -m 0644 "${here}/nginx/satrn-rate-limit.conf" /etc/nginx/conf.d/satrn-rate-limit.conf
if [[ ! -f /etc/nginx/sites-available/satrn ]]; then
  install -o root -g root -m 0644 "${here}/nginx/satrn" /etc/nginx/sites-available/satrn
else
  log "sites-available/satrn esiste già (forse gestito da Certbot): non sovrascritto"
fi
ln -sfn /etc/nginx/sites-available/satrn /etc/nginx/sites-enabled/satrn
nginx -t
systemctl reload nginx

cat <<EOF

Setup completato. Passi successivi:

1. Compilare ${APP_DIR}/.env.local (Supabase URL, publishable key, service role key):
     sudo -u ${DEPLOY_USER} nano ${APP_DIR}/.env.local
2. Record DNS su OVH:  ${DOMAIN}  A/CNAME -> questo server (come stellr.zeroradiation.eu)
3. Certificato TLS:    sudo certbot --nginx -d ${DOMAIN}
4. Primo rilascio:     sudo satrn-release
5. Monitoraggio: inserire il Ping URL in /etc/satrn/monitoring.env, poi
     sudo systemctl enable --now satrn-health-heartbeat.timer
6. Supabase -> Authentication -> URL Configuration: Site URL e Redirect URLs su https://${DOMAIN}
EOF
